[Unit]
Description=Jukebox: Paw Key push-to-talk daemon
PartOf=jukebox.target
After=jukebox-sonos.service jukebox-llm.service
Wants=jukebox-sonos.service jukebox-llm.service

[Service]
Type=simple
User=jetson
# input: read /dev/input/event* (Paw Key);  audio: arecord from the mic.
SupplementaryGroups=input audio
EnvironmentFile=-/home/jetson/development/config/jukebox.env
# Unbuffered so the daemon's stdout (heard/intent/searching) reaches the journal.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/jetson/development/src/pawkey_listen.py
Restart=always
RestartSec=3

[Install]
WantedBy=jukebox.target
