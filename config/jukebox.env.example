# Central config for the Jetson Voice Jukebox services and scripts.
# No secrets here (those live in tools/node-sonos-http-api/settings.json).
# Sourced by the launchers, health check, and readiness script.
#
# TEMPLATE. Copy to config/jukebox.env (gitignored) and fill in your own values:
#   cp config/jukebox.env.example config/jukebox.env
# Real room names and the Wi-Fi SSID live only in your local config/jukebox.env.

# Home Wi-Fi SSID for the headless auto-connect helper (setup/wifi_autoconnect.sh
# reads this when no SSID is passed on the command line). Local only.
JUKEBOX_WIFI_SSID="YOUR_WIFI_SSID"

# Default Sonos room for playback when a request doesn't name one.
JUKEBOX_ROOM="Living Room"

# All Sonos rooms the jukebox may target by voice (comma-separated). Used to
# recognize a spoken room name ("play it in the boys room"); when none is said,
# JUKEBOX_ROOM above is used.
JUKEBOX_ROOMS="Living Room,Boys Room,Kids Room"

# Volume behavior: by default the jukebox MAINTAINS each room's current volume
# (a party stays loud; a bedroom audiobook stays quiet). A song changes the
# volume only if the request explicitly asks ("play X at volume 40"). To instead
# force every song to a fixed starting volume, uncomment and set a number here:
# JUKEBOX_DEFAULT_VOLUME=28

# ALSA device for spoken/meow output. Currently the ReSpeaker's own audio out
# (card "Array"). Change to the Pebble V3 once it's on the powered hub, e.g.
# JUKEBOX_AUDIO_DEVICE="plughw:CARD=Pebble,DEV=0"  (check `aplay -l`).
JUKEBOX_AUDIO_DEVICE="plughw:CARD=V3,DEV=0"

# Mic capture device (ReSpeaker XVF3800 shows up as ALSA card "Array").
JUKEBOX_MIC_DEVICE="plughw:CARD=Array,DEV=0"

# Sound played when the whole system is up and ready (repo-relative path).
JUKEBOX_READY_SOUND="assets/mixkit-sweet-kitty-meow-93.wav"

# Quiet hours: songs play only when the LOCAL clock is within this window
# (inclusive start, exclusive end). Enforced deterministically by
# setup/within_play_hours.sh — outside it, a request is logged as 'blocked_time'
# and not played. Default: 5:00 AM to 10:00 PM.
JUKEBOX_PLAY_START="05:00"
JUKEBOX_PLAY_END="22:00"
# Spoken on the Pebble (Piper TTS) when a request is refused outside play hours
# (falls back to the static beep if Piper isn't installed).
JUKEBOX_QUIET_HOURS_MESSAGE="It's past your bedtime. Go to bed!"

# Content gate (src/blocklist.py): refuse songs Spotify flags as explicit. The
# request is still logged (outcome=blocked_explicit, block_reason=explicit) so it
# shows in the dashboard's Blocked view. Set to 0 to allow explicit tracks.
JUKEBOX_BLOCK_EXPLICIT="1"

# Sound played to the requestor when a song is refused (explicit / blocklisted) —
# repo-relative or absolute WAV. Placeholder for now: a short descending "denied"
# beep (assets/blocked.wav). Swap for a spoken "sorry, that song isn't allowed"
# clip once TTS lands. Blank = block silently (still logged).
JUKEBOX_BLOCKED_SOUND="assets/blocked.wav"

# Audiobooks (Audible) — the special case; everything else is a Spotify song.
# A leading keyword routes to Audible, which plays a parent-curated Sonos FAVORITE
# (Audible has no catalog search API). Favorite the books you want available in the
# Sonos app ("Add to My Sonos"); ONLY those are ever searched — never the full
# catalog. "book"/"story" are kid-natural but can false-trigger on songs starting
# with those words (e.g. "Story of My Life") — trim this list to be stricter.
JUKEBOX_AUDIBLE_KEYWORDS="audible,audiobook,book,story"
# Optional: restrict matching to these exact favorite titles (comma-separated).
# Blank = auto-detect audiobook favorites (anything not Spotify/radio/http).
# JUKEBOX_AUDIBLE_FAVORITES=""
# "continue my book" resumes the active book via this container favorite (the new
# Sonos app keeps per-book favorites in the cloud, invisible to local FV:2 — see
# docs/audible.md). Must match the exact Sonos favorite title.
JUKEBOX_AUDIBLE_CONTAINER="Audible.com"
JUKEBOX_AUDIBLE_RESUME_PHRASES="continue my book,resume my book,continue my audiobook,continue the book,keep reading,continue reading,play my book,continue my story,continue book"

# Albums & playlists (Spotify) — keyword-triggered like Audible; songs stay the
# default. "play the <X> album" / "play the <X> playlist". Public playlists (incl.
# Spotify's curated ones, and your own if PUBLIC) are found by name. For PRIVATE
# playlists, map a spoken name to its URI here (comma-separated):
# JUKEBOX_PLAYLISTS="bedtime=spotify:playlist:37i9dQZF1DX...,party=spotify:playlist:..."
# BETTER for your own private playlists: run `python3 setup/spotify_user_auth.py`
# once (read-only Spotify OAuth) — then "play my <name> playlist" finds ALL your
# private/collaborative playlists by name automatically, no map needed. Resolve
# order is: JUKEBOX_PLAYLISTS map → your own playlists → public search. Tokens live
# in config/spotify-user-tokens.json (gitignored). See docs/spotify-playlists-research.md.
#   JUKEBOX_SPOTIFY_PLAYLIST_CACHE_TTL="21600"   # secs to cache your playlist list (6h)
#   JUKEBOX_SPOTIFY_PLAYLIST_CUTOFF="0.6"        # fuzzy-match threshold (0..1)
#   JUKEBOX_SPOTIFY_REDIRECT_URI="http://127.0.0.1:8090/callback"  # must match the app
# (Explicit gate: albums are pre-scanned and refused if any track is explicit when
#  JUKEBOX_BLOCK_EXPLICIT=1; playlist scanning is best-effort — Spotify 403s user
#  playlists — so prefer trusted/curated playlists. See docs/collections.md.)

# Easter egg ("No Stairway. Denied!"): if a request resolves to Led Zeppelin's
# Stairway to Heaven, a LOCAL clip plays on the Pebble instead of the song on Sonos
# (logged outcome=blocked_easteregg, block_reason="Easter egg"). The clip is
# user-supplied and gitignored — drop your WAV at the path below.
JUKEBOX_EASTEREGG_SOUND="assets/no_stairway.wav"
# Matched track IDs (official Led Zeppelin remasters); a title+artist check is the
# safety net. Override/extend here if needed:
# JUKEBOX_STAIRWAY_IDS="5CQ30WqJwcep0pYcV4AMNc,0RO9W1xJoUEpq5MEelddFb,12wlYeErSUNGg1B5d64077,3sxIm3lTgdvXJdNHNn64BS"

# Local TTS (Piper) for spoken feedback — e.g. when a song is refused for explicit
# lyrics, the Pebble SPEAKS the retrieved song + artist (STT/intent often mishear,
# so hearing what was actually found bridges the disconnect). Install with
# setup/install_piper.sh (downloads the aarch64 binary + a voice into tools/piper/,
# gitignored). Until installed, blocked feedback falls back to the static beep.
# JUKEBOX_PIPER_BIN="tools/piper/piper/piper"
JUKEBOX_PIPER_VOICE="tools/piper/voices/en_US-ryan-medium.onnx"

# Service ports.
SONOS_PORT=5005
LLAMA_PORT=8080

# Request dashboard (jukebox-dashboard.service) — LAN web UI over the request log.
# It reads a read-only Parquet snapshot of data/jukebox.duckdb (never the live
# file), so it can't lock playback. See docs/dashboard.md.
JUKEBOX_DASH_PORT=8088
JUKEBOX_DASH_BIND="0.0.0.0"           # LAN-reachable; set 127.0.0.1 to restrict to the box
JUKEBOX_DASH_SNAPSHOT_SECONDS=60      # how often the snapshot refreshes from the live DB
JUKEBOX_DISK_WARN_PCT=10              # disk card warns when free space drops under this %
